{
  "functions": {
    "api/gateway.ts": {
      "includeFiles": "{lib/server/**,src/lib/hera/**,api/_routes/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/titan-daily",
      "schedule": "0 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/webhook/?$).*)",
      "has": [{ "type": "host", "value": "synexus.pro" }],
      "destination": "https://www.synexus.pro/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/gateway?__route=/api/:path*"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
