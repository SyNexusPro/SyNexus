{
  "functions": {
    "api/checkout.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/analytics.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/titan/chat.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/titan/warm.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/titan/event.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/cron/titan-daily.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/whale/webhook.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/whale/poll.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/whale/events.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/push/subscribe.ts": {
      "includeFiles": "lib/server/**"
    },
    "api/subscription/webhook.ts": {
      "includeFiles": "lib/**"
    },
    "api/webhook.ts": {
      "includeFiles": "lib/**"
    },
    "api/square/webhook.ts": {
      "includeFiles": "lib/**"
    }
  },
  "crons": [
    {
      "path": "/api/whale/poll",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/titan-daily",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
