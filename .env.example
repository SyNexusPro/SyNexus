# Browser bundle (must exist when Vercel runs `vite build` — add under Project → Settings → Environment Variables)
# Android/iOS: same VITE_* vars are embedded at `npm run build` — keep .env locally before `npm run android:bundle`.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In uses Supabase Auth (no extra VITE_*). In the dashboard:
# Authentication → Providers → Google (enable, add Google Cloud client ID + secret)
# Authentication → URL Configuration → add Redirect URLs:
#   http://localhost:5173/pulse
#   https://www.synexus.pro/pulse
#   https://synexus.pro/pulse
#   https://www.synexus.pro/security/verify
#   https://www.synexus.pro/security/setup
# Site URL should match the production origin. Android in-app Google OAuth is not wired yet.
# Enable Authentication → MFA (TOTP) in the Supabase dashboard.
# Optional passkeys (does not replace TOTP):
# VITE_SYNEXUS_PASSKEYS=true

# Server-side alias (webhooks, analytics API) — same project URL
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres URL for npm run supabase:migrate (Dashboard → Connect → URI, Session mode)
# Or paste supabase/apply-all.sql once in SQL Editor (no password needed):
# https://supabase.com/dashboard/project/zyroyqcyjmcgdcywnjxn/sql/new
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

VITE_BIRDEYE_API_KEY=your-birdeye-api-key
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_APP_URL=http://localhost:5173

# Google Analytics 4 (global page views — embedded at build time)
VITE_GA_MEASUREMENT_ID=G-N7W1GFMFC2

# Google AdSense — home page display unit (data-ad-slot from AdSense dashboard)
VITE_ADSENSE_HOME_SLOT=1614797121

# Optional external pricing page URL for /pricing
# VITE_SUBSCRIPTION_PRICING_URL=

# Optional alias — vite.config.ts falls back if VITE_SUPABASE_ANON_KEY is missing
SUPABASE_ANON_KEY=your-anon-key

# Public support / contact (Contact page, legal mailto links, bug reports)
VITE_SUPPORT_EMAIL=thesynexus@synexus.pro

# Owner account — server-only (never VITE_*).
# Login is the Supabase Auth user for this email. The server checks the session.
# It does not compare SYNEXUS_OWNER_PASSWORD. That value is only a fallback HMAC
# signing secret when SYNEXUS_OWNER_SIGNING_KEY is unset.
# Create the user in Supabase → Authentication → Users, and confirm the email.
SYNEXUS_OWNER_EMAIL=owner@synexus.pro
SYNEXUS_OWNER_PASSWORD=change-me-to-a-long-secret
# SYNEXUS_OWNER_SIGNING_KEY=long-random-string

# Hera Developer — server only. Never VITE_* and never commit the real values.
# Cursor Dashboard → API Keys. Cloud investigations stay off while the monthly limit is 0.
# CURSOR_API_KEY=
# HERA_DEVELOPER_MONTHLY_USD=0
# HERA_DEVELOPER_RUN_RESERVE_USD=1
# CRON_SECRET=long-random-string
# SYNEXUS_IDENTITY_PEPPER=long-random-string-for-hashing-id-fingerprints

# SyNexus Community — all gates default off during development.
# UI/build exposure only:
VITE_COMMUNITY_ENABLED=false
# Authoritative server gate (database community_settings.enabled must also be true):
COMMUNITY_ENABLED=false

# Titan AI — server-only (never VITE_*). Powers real conversations in /api/titan/chat
# and Hera listen transcription at /api/hera/stt
OPENAI_API_KEY=sk_replace_me
# Hera spoken brain uses this key + GPT-4o (not Groq). Restart Vite after setting it.
# HERA_OPENAI_MODEL=gpt-4o
# Hera live WebRTC speech-to-speech (session minted server-side — never VITE_*)
# Original Hera voice — do not set this to clone a copyrighted character.
# OPENAI_LIVE_MODEL=gpt-live-1
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Default voice. Operators can override per device in Pulse → Hera Listen.
# marin cedar quartz ripple vesper willow stone gleam meridian bossa tempo beacon delta cinder
# OPENAI_REALTIME_VOICE=marin
# Hera signature voice — ElevenLabs keys stay server-side
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Optional OpenAI TTS fallback for /api/hera/tts
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin
# OPENAI_TTS_INSTRUCTIONS=
# Titan / Hera chat uses OpenAI only (OPENAI_API_KEY above). Groq is not used.
# Optional model overrides:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_PRO=gpt-4o
# OPENAI_MODEL_FREE=gpt-4o-mini
# HERA_OPENAI_MODEL=gpt-4o
# TITAN_MAX_TOKENS=480
# TITAN_MAX_TOKENS_PRO=640

# Server-to-server Hera intelligence (POST /api/hera/intel). Never a VITE_* variable.
# This is not the LLM key (OPENAI_API_KEY) and not a cron or webhook secret.
# Put a long random value in Vercel server env. Alexus sends it as Authorization: Bearer.
# Alexus calls it through its own HERA_BASE_URL (not SYNEXUS_TITAN_API_URL, which Alexus treats as an
# OpenAI-style chat endpoint for its AI triad and must stay unset).
# Authority readings also need SOLANA_RPC_URL, or the existing VITE_SOLANA_RPC_URL.
# If neither RPC URL is set, mint and freeze authority are reported as not configured.
SYNEXUS_TITAN_API_KEY=

# Alexus -> Hera learning reports (POST /api/hera/ingest). Server-only; a different secret from the one above.
# Bearer token and HMAC-SHA256 signing key for the body (min 32 chars). Alexus uses the same value as HERA_INGEST_TOKEN.
# Reports are stored in public.alexus_reports (supabase/alexus_reports.sql, run it in the Supabase SQL editor).
HERA_INGEST_TOKEN=

# Langfuse traces for Hera chat: why she answered, what failed, and the estimated token cost.
# Server-only. Leave blank and traces stay local to the request; nothing is sent.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Previous research retrieval uses OPENAI_API_KEY (already the chat key) and supabase/hera_memory.sql.
# Run that SQL in the Supabase SQL editor before Hera can store or retrieve memories.

# Optional Jupiter quote key. Server-only. Sent as x-api-key to api.jup.ag on quote-only requests.
# Without it, Hera uses the public lite quote URL. Never used to execute a swap.
# JUPITER_API_KEY=

# Approved read-only tools: POST /api/hera/mcp with the same Bearer key as SYNEXUS_TITAN_API_KEY.
# Tools are venue prices, Alexus lessons, a Jupiter quote comparison, and memory search. No trade tool.

# Optional — affiliate payout dashboard (Hub). When set, the payout control opens this URL in a new tab.
# VITE_AFFILIATE_PAYOUT_URL=https://your-payout-or-connect-portal.example

# Optional — SYN community token (must be a mint that exists on Solana mainnet)
# VITE_SYN_MINT=9naVtLAGKWYuEcGehe1BZ3DpiSLHjSNsaeFr2JPHpump
# SYN_MINT=9naVtLAGKWYuEcGehe1BZ3DpiSLHjSNsaeFr2JPHpump
# VITE_SYN_LIVE=1

# Optional — Hera launch watch on X (Twitter API v2 recent search). Without this, she still watches pump.fun, Dex, Reddit, and news.
# X_BEARER_TOKEN=

# In-app Trade/Swap (Jupiter). Default OFF for the first public release.
# Set both to true only after you approve live trading.
# VITE_TRADING_ENABLED=true
# Second flag required to show Trade inside the native Android app:
# VITE_TRADING_ANDROID=true
# Optional WalletConnect / Reown Cloud project ID (public, domain-allowlisted):
# VITE_WALLETCONNECT_PROJECT_ID=
# Jupiter platform-fee token account (public address only — never a private key)
# VITE_JUPITER_FEE_ACCOUNT=
# Server copy of the same public fee account. The trade API uses this and ignores a fee sent by the browser.
# JUPITER_FEE_ACCOUNT=

# RevenueCat — ARCHIVED. Code kept for rollback only. Web billing is Paddle.
# REVENUECAT_ARCHIVED=true
# VITE_REVENUECAT_ARCHIVED=true
# VITE_REVENUECAT_TEST_API_KEY=
# VITE_REVENUECAT_USE_TEST_STORE=true
# VITE_REVENUECAT_API_KEY=
# REVENUECAT_SECRET_API_KEY=
# REVENUECAT_WEBHOOK_AUTHORIZATION=

# Paddle (web checkout + billing). Server secrets never use VITE_*.
# Required: never leave VITE_PADDLE_ENVIRONMENT unset (no silent default).
PADDLE_ENVIRONMENT=production
VITE_PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=
# Notification destination: https://www.synexus.pro/api/paddle/webhook
PADDLE_WEBHOOK_SECRET=
# Live client-side token (prefixed live_). Create under Paddle > Developer tools > Authentication.
VITE_PADDLE_CLIENT_TOKEN=
# 3-tier pricing (Starter / Pro / Advanced) × monthly + yearly. Required for /pricing.
# Starter month may fall back to VITE_PADDLE_NEXT_LEVEL_PRICE_ID; Advanced month to VITE_PADDLE_PANTHEON_PRICE_ID.
VITE_PADDLE_STARTER_MONTH_PRICE_ID=
VITE_PADDLE_STARTER_YEAR_PRICE_ID=
VITE_PADDLE_PRO_MONTH_PRICE_ID=
VITE_PADDLE_PRO_YEAR_PRICE_ID=
VITE_PADDLE_ADVANCED_MONTH_PRICE_ID=
VITE_PADDLE_ADVANCED_YEAR_PRICE_ID=
# Legacy aliases (optional)
VITE_PADDLE_NEXT_LEVEL_PRICE_ID=
VITE_PADDLE_PANTHEON_PRICE_ID=
# Optional: set false to force-disable live overlay even when production token is present
# VITE_PADDLE_LIVE_CHECKOUT=true

