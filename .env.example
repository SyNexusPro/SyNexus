# Browser bundle (must exist when Vercel runs `vite build` — add under Project → Settings → Environment Variables)
# Android/iOS: same VITE_* vars are embedded at `npm run build` — keep .env locally before `npm run android:bundle`.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In uses Supabase Auth (no extra VITE_*). In the dashboard:
# Authentication → Providers → Google (enable, add Google Cloud client ID + secret)
# Authentication → URL Configuration → add Redirect URLs:
#   http://localhost:5173/pulse
#   https://www.synexus.pro/pulse
#   https://synexus.pro/pulse
# Site URL should match the production origin. Android in-app Google OAuth is not wired yet.

# Server-side alias (webhooks, analytics API) — same project URL
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres URL for npm run supabase:migrate (Dashboard → Connect → URI, Session mode)
# Or paste supabase/apply-all.sql once in SQL Editor (no password needed):
# https://supabase.com/dashboard/project/zyroyqcyjmcgdcywnjxn/sql/new
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

VITE_BIRDEYE_API_KEY=your-birdeye-api-key
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_APP_URL=http://localhost:5173

# Google Analytics 4 (global page views — embedded at build time)
VITE_GA_MEASUREMENT_ID=G-N7W1GFMFC2

# Google AdSense — home page display unit (data-ad-slot from AdSense dashboard)
VITE_ADSENSE_HOME_SLOT=1614797121

# Square subscription billing (hosted checkout via Payment Links API)
# SQUARE_PLAN_VARIATION_ID_PRO — catalog variation ID or SKU (e.g. SyNexusPro)
# Production: SQUARE_API_BASE=https://connect.squareup.com
# Sandbox: SQUARE_API_BASE=https://connect.squareupsandbox.com
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_PLAN_VARIATION_ID_PRO=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match Square Dashboard webhook URL exactly
SQUARE_WEBHOOK_NOTIFICATION_URL=https://synexus.pro/api/webhook

# Optional external pricing page URL for /pricing
# VITE_SUBSCRIPTION_PRICING_URL=

# Optional alias — vite.config.ts falls back if VITE_SUPABASE_ANON_KEY is missing
SUPABASE_ANON_KEY=your-anon-key

# Public support / contact (Contact page, legal mailto links, bug reports)
VITE_SUPPORT_EMAIL=thesynexus@synexus.pro

# Owner command code — server-only (never VITE_*). Unlocks full Pro without payment.
# Set your own values; run: node scripts/generate-owner-code.mjs
SYNEXUS_OWNER_EMAIL=owner@synexus.pro
SYNEXUS_OWNER_PASSWORD=change-me-to-a-long-secret
# SYNEXUS_IDENTITY_PEPPER=long-random-string-for-hashing-id-fingerprints

# Titan AI — server-only (never VITE_*). Powers real conversations in /api/titan/chat
# and Hera listen transcription at /api/hera/stt
OPENAI_API_KEY=sk_replace_me
# Hera spoken brain uses this key + GPT-4o (not Groq). Restart Vite after setting it.
# HERA_OPENAI_MODEL=gpt-4o
# Hera live WebRTC speech-to-speech (ephemeral client secret minted server-side — never VITE_*)
# Original Hera voice — do not set this to clone a copyrighted character.
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=coral
# Hera signature voice — ElevenLabs keys stay server-side
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Optional OpenAI TTS fallback for /api/hera/tts
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_TTS_INSTRUCTIONS=
# Or use TITAN_API_KEY / TITAN_API_BASE for OpenRouter, Groq, etc.
# TITAN_API_KEY=
# TITAN_API_BASE=https://api.openai.com/v1
# TITAN_MODEL=gpt-4o-mini
# TITAN_MODEL_PRO=gpt-4o
# TITAN_MODEL_FREE=gpt-4o-mini
# Groq (fast): TITAN_API_BASE=https://api.groq.com/openai/v1
# TITAN_MODEL_FREE=llama-3.1-8b-instant
# TITAN_MODEL_PRO=llama-3.3-70b-versatile
# TITAN_MAX_TOKENS=480
# TITAN_MAX_TOKENS_PRO=640

# Optional — affiliate payout dashboard (Hub). When set, the payout control opens this URL in a new tab.
# VITE_AFFILIATE_PAYOUT_URL=https://your-payout-or-connect-portal.example

# Optional — SYN community token (must be a mint that exists on Solana mainnet)
# VITE_SYN_MINT=9naVtLAGKWYuEcGehe1BZ3DpiSLHjSNsaeFr2JPHpump
# SYN_MINT=9naVtLAGKWYuEcGehe1BZ3DpiSLHjSNsaeFr2JPHpump
# VITE_SYN_LIVE=1

# Optional — Hera launch watch on X (Twitter API v2 recent search). Without this, she still watches pump.fun, Dex, Reddit, and news.
# X_BEARER_TOKEN=

# In-app Trade/Swap (Jupiter). Default OFF — keep unset/false for Play Store intelligence builds.
# Google does not treat a later trading update as covered by an intelligence-only review.
# VITE_TRADING_ENABLED=false
# Second flag required to show Trade inside the native Android app:
# VITE_TRADING_ANDROID=false
# Jupiter platform-fee token account (public address only — never a private key)
# VITE_JUPITER_FEE_ACCOUNT=
